# Copy to .env and adjust. `.env` is git-ignored (never commit real secrets).

# Host port the app is published on (http://localhost:<WEB_PORT>)
WEB_PORT=4001

# Development enables the Scalar API UI at /scalar; use Production for a leaner run
ASPNETCORE_ENVIRONMENT=Development

# Google OAuth. Placeholders are enough to run and join as a guest.
# For real Scrum Master sign-in, create an OAuth client (see README) and set these,
# with http://localhost:4001/signin-google as an authorized redirect URI.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Optional sample data (Development only)
SEED_ENABLED=false
SEED_USER_EMAIL=dev@localhost

# Image tag used by docker compose
REFLEKT_IMAGE=reflekt:local
